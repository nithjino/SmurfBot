HASHICORP_VAULT_URL=https://vault.example.com
HASHICORP_VAULT_USERNAME=replace_with_vault_username
HASHICORP_VAULT_PASSWORD=replace_with_vault_password
SMURFBOT_VAULT_USERPASS_MOUNT=userpass
SMURFBOT_VAULT_TOKEN_PATH=smurfbot/data/tokens

